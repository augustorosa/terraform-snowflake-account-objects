# Feature Flags Example Configuration
# Copy this file to terraform.tfvars and customize the values

# =============================================================================
# SNOWFLAKE CONNECTION
# =============================================================================

organization_name    = "your-organization"
snowflake_account    = "your-account"
snowflake_username   = "your-username"
snowflake_password   = "your-password"

# Preview Features (enable as needed)
preview_features_enabled = ["snowflake_table_resource"]

# =============================================================================
# PROJECT CONFIGURATION
# =============================================================================

project_name = "analytics"
environment  = "dev"

# =============================================================================
# DEPLOYMENT SCENARIOS - CHOOSE ONE OR MORE
# =============================================================================

# Deploy everything (recommended for testing all features)
deploy_full_stack = true

# Deploy only RBAC and tagging (minimal setup)
deploy_minimal_stack = false

# Deploy RBAC, tagging, and databases only
deploy_database_only = false

# =============================================================================
# S3 CONFIGURATION (FOR DATA LOADING - OPTIONAL)
# =============================================================================

# External S3 stages (leave as defaults to use internal stages)
s3_data_lake_url = "@~/data_lake/"     # Change to "s3://your-bucket/data-lake/" for external
s3_streaming_url = "@~/streaming/"     # Change to "s3://your-bucket/streaming/" for external
s3_credentials   = ""                  # Add AWS credentials for external stages

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================

admin_email_list = ["admin@yourcompany.com"]
etl_team_emails  = ["etl-team@yourcompany.com"]
dev_team_emails  = ["dev-team@yourcompany.com"]

# =============================================================================
# ADVANCED FEATURES
# =============================================================================

# Enable automatic classification (Enterprise Edition)
enable_auto_classification = false

# Enable RSA key-pair authentication for service users
enable_key_pair_auth = false

# Enable Personal Access Token (PAT) creation
enable_pat_tokens = false

# Enable authentication policies for enhanced security
enable_authentication_policies = false

# Enable external OAuth integrations for workload identity federation
enable_external_oauth = false

# Enable Cortex AI features (requires appropriate Snowflake edition)
enable_cortex_ai = false

