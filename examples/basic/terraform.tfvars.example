# Rename this file to terraform.tfvars and fill in your values

# Snowflake Configuration
snowflake_organization = "your-organization"
snowflake_account_name = "your-account"
snowflake_username     = "terraform_user"
snowflake_password     = "your-secure-password"  # Consider using environment variables instead

# Project Configuration
project_name = "analytics"
environment  = "dev"

# Tagging
# Note: cost_center and owner_email removed - these tags are not automatically applied by the module 